# Google AI Studio API key. Leave blank until you choose to configure a live run.
GEMINI_API_KEY=
# Confirm that this model is enabled for your API project and supports Google Search grounding.
GEMINI_MODEL=gemini-3.8-flash
MAX_WARDS_PER_RUN=2
# Legacy valuation path only; current listing research is whitelist-bounded to 100 wards maximum.
MAX_TOTAL_WARDS=100
MAX_TOTAL_LISTINGS=500
MAX_NEW_LISTINGS_PER_WARD=10
# Local request ceiling, not an account quota or cost estimate. One Gemini call can issue multiple searches.
MAX_CALLS_PER_MONTH=2
REFRESH_DAYS=30
RETRY_DAYS=7
MAX_ATTEMPTS_PER_WARD=3

# Gmail is opt-in. Keep disabled until SMTP credentials and the recipient are configured.
ENABLE_EMAIL=false
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
REPORT_TO=

# Temporary synthetic demo mode. Prefer setting this only in the PowerShell
# session used to launch the demo; demo mode refuses the production DB path.
# WARDPRICE_DEMO_MODE=1
