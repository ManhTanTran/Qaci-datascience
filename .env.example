# Sao chép thành .env (không commit). Dùng chung cho cả repo.

# Module 1 — thu thập: Tavily (tìm web) + model tổng hợp (OpenAI-compatible, vd. Gemma)
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gemma-4-31B-it

# Module 2 — trích xuất claim. Bỏ trống thì dùng lại cặp OPENAI_API_KEY / OPENAI_BASE_URL ở trên.
EXTRACTOR_API_KEY=
EXTRACTOR_BASE_URL=

# Tuỳ chọn: đổi file hand-off dùng chung (mặc định lấy từ config.yaml → data/llm_answers.jsonl)
# LLM_ANSWERS_FILE=data/llm_answers.jsonl
